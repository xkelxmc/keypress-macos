    } },
    "about.onboarding.action" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Onboarding wiederholen" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Replay Onboarding" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Repetir introducción" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revoir l’introduction" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пройти онбординг снова" } }
    } },
    "about.onboarding.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Vor dem Start wird nichts zurückgesetzt. Ihre Auswahl wird sofort angewendet." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing is reset before you begin. Any choices you make are applied live." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "No se restablece nada antes de empezar. Tus cambios se aplican al instante." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rien n’est réinitialisé avant de commencer. Vos choix s’appliquent immédiatement." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перед запуском ничего не сбрасывается. Новые варианты применяются сразу." } }
    } },
    "about.onboarding.title" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Willkommenstour" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome Tour" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Tour de bienvenida" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Visite de bienvenue" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Приветственный тур" } }
    } },
    "about.privacy.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Tastatureingaben werden lokal verarbeitet und niemals aufgezeichnet, gespeichert oder übertragen." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Keyboard input is processed locally and is never recorded, stored, or transmitted." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "La entrada del teclado se procesa localmente y nunca se graba, almacena ni transmite." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les saisies clavier sont traitées localement et ne sont jamais enregistrées, stockées ni transmises." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ввод с клавиатуры обрабатывается локально и никогда не записывается, не сохраняется и не передаётся." } }
    } },
    "about.privacy.detail" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Keypress verarbeitet Tastatur- und Zeigerereignisse nur, um Einblendungen darzustellen. Tastenanschläge, eingegebener Text, Zeigerpositionen oder Nutzungsanalysen werden weder aufgezeichnet noch gespeichert oder übertragen. Alles läuft auf Ihrem Mac." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Keypress processes keyboard and pointer events only to draw its overlays. It does not record, store, or transmit keystrokes, typed text, pointer positions, or usage analytics. Everything runs on your Mac." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Keypress procesa los eventos del teclado y del puntero solo para dibujar sus superposiciones. No graba, almacena ni transmite pulsaciones, texto escrito, posiciones del puntero ni analíticas de uso. Todo funciona en tu Mac." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Keypress traite les événements du clavier et du pointeur uniquement pour afficher ses superpositions. Les frappes, le texte saisi, les positions du pointeur et les données d’utilisation ne sont ni enregistrés, ni stockés, ni transmis. Tout s’exécute sur votre Mac." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Keypress обрабатывает события клавиатуры и указателя только для отрисовки оверлеев. Нажатия, введённый текст, положения указателя и аналитика использования не записываются, не сохраняются и не передаются. Всё работает на вашем Mac." } }
    } },
    "about.product.description" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Keypress macht Tastenkürzel und Zeigeraktionen in Tutorials, Präsentationen, Live-Demos und Bildschirmaufnahmen leicht verständlich. Alles wird lokal dargestellt; Designs, Layout und Bildschirmpositionen lassen sich anpassen." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Keypress makes keyboard shortcuts and pointer actions easy to follow in tutorials, presentations, live demos, and screen recordings. Everything is rendered locally, with customizable themes, layouts, and display placement." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Keypress hace que los atajos de teclado y las acciones del puntero sean fáciles de seguir en tutoriales, presentaciones, demostraciones y grabaciones de pantalla. Todo se representa localmente y permite personalizar temas, diseños y posiciones en pantalla." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Keypress rend les raccourcis clavier et les actions du pointeur faciles à suivre dans les tutoriels, présentations, démonstrations et enregistrements d’écran. Tout est rendu localement, avec des thèmes, des dispositions et des positions d’écran personnalisables." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Keypress делает сочетания клавиш и действия указателя понятными в обучающих материалах, презентациях, демонстрациях и записях экрана. Всё отрисовывается локально, а темы, компоновка и положение на дисплеях настраиваются." } }
    } },
    "about.product.subtitle" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Produktinformationen, Datenschutz, Neuigkeiten und Support." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Product information, privacy, release notes, and support." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Información del producto, privacidad, novedades y soporte." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Informations produit, confidentialité, nouveautés et assistance." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Информация о продукте, конфиденциальность, новинки и поддержка." } }
    } },
    "about.release.cursor.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Eigene Formen, Farben, Leuchten und reaktive Klick-, Zieh-, Bewegungs- und Scroll-Effekte." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom shapes, colors, glow, and responsive click, drag, motion, and scroll reactions." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Formas, colores, resplandor y reacciones a clics, arrastre, movimiento y desplazamiento." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Formes, couleurs, lueur et réactions aux clics, glissements, mouvements et défilements." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настраиваемые формы, цвета, свечение и реакции на клики, перетаскивание, движение и прокрутку." } }
    } },
    "about.release.cursor.title" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Cursor-Halo" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Cursor Halo" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Halo del cursor" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Halo du curseur" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подсветка курсора" } }
    } },
    "about.release.displays.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeigen Sie einen Tastaturstatus auf ausgewählten Displays mit gespeicherten Positionen pro Bildschirm." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Show one keyboard state across selected displays with positions saved per screen." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Muestra un mismo estado del teclado en las pantallas elegidas con posiciones guardadas por pantalla." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Affichez un même état du clavier sur les écrans sélectionnés avec une position mémorisée par écran." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показывайте одно состояние клавиатуры на выбранных дисплеях с отдельной сохранённой позицией для каждого." } }
    } },
    "about.release.displays.title" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Mehrere Displays" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Multi-Display" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Varias pantallas" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Multi-écrans" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Несколько дисплеев" } }
    } },
    "about.release.history.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Nutzen Sie den gestapelten Verlauf und bestimmen Sie sichtbare Modifikator-, Funktions- und Sondertasten." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Use stacked typing history and decide which modifiers, function, and special keys appear." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Usa el historial apilado y elige qué modificadores y teclas de función o especiales aparecen." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilisez l’historique empilé et choisissez les modificateurs, touches de fonction et touches spéciales affichés." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Используйте историю столбцом и выбирайте, какие модификаторы, функциональные и специальные клавиши показывать." } }
    } },
    "about.release.history.title" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Verlauf & Filter" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "History & Filters" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Historial y filtros" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Historique et filtres" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "История и фильтры" } }
    } },
    "about.release.position.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Ziehen Sie das echte Tastatur-Overlay mit Einrasten, Zurücksetzen und Abbrechen an die gewünschte Stelle." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag the real keyboard overlay into place with snapping, reset, and cancel." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Arrastra la superposición real del teclado con ajuste, restablecimiento y cancelación." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Placez la véritable superposition du clavier par glissement, avec alignement, réinitialisation et annulation." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перетаскивайте настоящий оверлей клавиатуры с привязкой, сбросом и отменой." } }
    } },
    "about.release.position.title" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Positionierung auf dem Bildschirm" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "On-Screen Positioning" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Posición en pantalla" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Positionnement à l’écran" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Позиционирование на экране" } }
    } },
    "about.release.reliability.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Robustere Behandlung von Tasten, Modifikatoren, Zeitlimits, Berechtigungen und Overlay-Zuständen." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "More resilient key, modifier, timeout, permission, and overlay state handling." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Gestión más resistente de teclas, modificadores, tiempos, permisos y estados de superposición." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Gestion plus robuste des touches, modificateurs, délais, autorisations et états de superposition." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Более надёжная обработка клавиш, модификаторов, таймаутов, разрешений и состояния оверлея." } }
    } },
    "about.release.reliability.title" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Zuverlässige Eingabe" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Reliable Input" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Entrada fiable" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Saisie fiable" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Надёжный ввод" } }
    } },
    "about.release.studio.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine skalierbare native Seitenleiste, angeheftete Live-Vorschauen und unabhängige Tastatur- und Zeigerdesigns." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "A resizable native sidebar, pinned live previews, and independent keyboard and pointer themes." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Una barra lateral nativa redimensionable, vistas previas fijas y temas independientes para teclado y puntero." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une barre latérale native redimensionnable, des aperçus épinglés et des thèmes indépendants pour le clavier et le pointeur." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Изменяемая нативная боковая панель, закреплённые живые превью и независимые темы клавиатуры и указателя." } }
    } },
    "about.release.studio.title" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Natives Studio" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Native Studio" } },
