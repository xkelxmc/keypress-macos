    "onboarding.permission.storage" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Tastenanschläge werden nie aufgezeichnet, gespeichert oder übertragen." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Keystrokes are never recorded, stored, or transmitted." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Las pulsaciones nunca se graban, almacenan ni transmiten." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les frappes ne sont jamais enregistrées, stockées ni transmises." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нажатия никогда не записываются, не хранятся и не передаются." } }
