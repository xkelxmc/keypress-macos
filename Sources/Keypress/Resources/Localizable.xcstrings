    "about.links" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Links & Support" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Links & Support" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Enlaces y soporte" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Liens et assistance" } },
