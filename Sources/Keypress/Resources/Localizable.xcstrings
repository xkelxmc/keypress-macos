    "displays.target.help" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "„Zeiger folgen“ verwendet das Display unter dem Zeiger. Positionen bleiben pro Display gespeichert." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow Pointer uses the display under the pointer. Placements stay saved per display." } },
