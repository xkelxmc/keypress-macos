      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Suivre le pointeur utilise l’écran sous le pointeur. Les positions restent enregistrées par écran." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Режим «За указателем» использует дисплей под указателем. Позиции сохраняются отдельно для каждого дисплея." } }
    } },
