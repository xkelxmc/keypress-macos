    "onboarding.settings.privacy.body" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Eingaben werden lokal verarbeitet und nie aufgezeichnet, gespeichert oder übertragen. Keypress benötigt nur Eingabemonitoring." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Input is processed locally and never recorded, stored, or transmitted. Keypress requests only Input Monitoring." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "La entrada se procesa localmente y nunca se graba, almacena ni transmite. Keypress solo solicita Monitorización de entrada." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les entrées sont traitées localement et ne sont jamais enregistrées, stockées ni transmises. Keypress demande uniquement la surveillance des entrées." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ввод обрабатывается локально и никогда не записывается, не хранится и не передаётся. Keypress запрашивает только Мониторинг ввода." } }
    } },
