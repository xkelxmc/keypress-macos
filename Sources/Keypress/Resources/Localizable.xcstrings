    } },
    "about.diagnostics.detail" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Exportieren Sie für den Support eine lokale Momentaufnahme von System und Einstellungen. Sie enthält niemals Eingabeinhalte, Zeigerkoordinaten, Pfade, Benutzernamen oder Display-IDs." } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Export a local system and settings snapshot for support. It never includes input content, pointer coordinates, paths, usernames, or display identifiers." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Exporta una instantánea local del sistema y los ajustes para soporte. Nunca incluye contenido introducido, coordenadas del puntero, rutas, nombres de usuario ni identificadores de pantalla." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Exportez un instantané local du système et des réglages pour l’assistance. Il ne contient jamais de saisies, coordonnées du pointeur, chemins, noms d’utilisateur ni identifiants d’écran." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Экспортируйте локальный снимок системы и настроек для поддержки. В нём никогда нет содержимого ввода, координат указателя, путей, имён пользователей или идентификаторов дисплеев." } }
    } },
    "about.diagnostics.export" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Diagnosebericht exportieren…" } },
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Export Diagnostic Report…" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Exportar informe de diagnóstico…" } },
